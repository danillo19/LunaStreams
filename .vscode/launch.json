{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "LunaStreams: low_cost_interactive (external terminal)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/runtime",
      "cwd": "${workspaceFolder}",
      "args": [
        "-ir",
        "${workspaceFolder}/examples/presence",
        "-task",
        "low_cost_interactive",
        "-debug"
      ],
      "console": "externalTerminal"
    },
